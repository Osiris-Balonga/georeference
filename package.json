{
  "name": "242places",
  "version": "1.2.1",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "description": "Generate source-backed Republic of Congo geographic files with auditable partial coverage.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "author": "Osiris Balonga",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./seeding": "./dist/seeding/index.js"
  },
  "bin": {
    "242places": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.fr.md",
    "CONTRIBUTING.md",
    "CONTRIBUTING.fr.md",
    "SECURITY.md",
    "SECURITY.fr.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs",
    "reference"
  ],
  "scripts": {
    "data:update": "node scripts/update-cascade.mjs",
    "data:check": "node scripts/update-cascade.mjs --check",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --test-concurrency=2 tests/*.test.ts",
    "test:postgres": "node --test tests/postgres.integration.test.ts tests/domain-postgres.integration.test.ts",
    "dev:api": "npm run build && npm run dev --workspace @242places/api",
    "build:api": "npm run build && npm run build --workspace @242places/api",
    "start:api": "npm run start --workspace @242places/api",
    "test:api": "npm run build && npm run test --workspace @242places/api",
    "typecheck:api": "npm run build && npm run typecheck --workspace @242places/api",
    "test:acceptance": "npm run build:api && node --test tests/acceptance/*.test.ts",
    "check": "npm run data:check && npm run typecheck && npm test && npm run build && npm run typecheck --workspace @242places/api && npm run test --workspace @242places/api && npm run build --workspace @242places/api && npm run test:web && npm run typecheck --workspace @242places/web && npm run build --workspace @242places/web",
    "prepack": "npm run build",
    "dev:web": "npm run dev --workspace @242places/web",
    "build:site": "npm run build:api && npm run build --workspace @242places/web",
    "start:site": "node scripts/serve-site.mjs",
    "test:web": "npm run test --workspace @242places/web",
    "test:site": "node --test tests/site.test.mjs"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.6.0",
    "pg": "^8.16.3",
    "yazl": "^3.3.1"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/yazl": "^3.3.0",
    "exceljs": "4.4.0",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Osiris-Balonga/242places.git"
  },
  "bugs": {
    "url": "https://github.com/Osiris-Balonga/242places/issues"
  },
  "homepage": "https://github.com/Osiris-Balonga/242places#readme"
}
